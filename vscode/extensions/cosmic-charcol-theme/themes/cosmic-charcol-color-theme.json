    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {
                "foreground": "#5c6370",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Doc Comments",
            "scope": ["comment.block.documentation", "comment.block.javadoc"],
            "settings": {
                "foreground": "#6b737d",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage.type", "storage.modifier"],
            "settings": {
                "foreground": "#c678dd"
            }
        },
        {
            "name": "Keyword Control",
            "scope": ["keyword.control", "keyword.control.conditional", "keyword.control.loop", "keyword.control.flow"],
            "settings": {
                "foreground": "#c678dd",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Keyword Operators",
            "scope": ["keyword.operator", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical", "keyword.operator.comparison"],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Operators",
            "scope": ["punctuation.accessor", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.type"],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "meta.function-call", "support.function"],
            "settings": {
                "foreground": "#61afef"
            }
        },
        {
            "name": "Built-in Functions",
            "scope": ["support.function.builtin", "support.function.console"],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Function Definition",
            "scope": ["entity.name.function.definition", "meta.definition.function entity.name.function"],
            "settings": {
                "foreground": "#61afef"
            }
        },
        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": {
                "foreground": "#98c379"
            }
        },
        {
            "name": "String Escape",
            "scope": ["constant.character.escape", "string.regexp"],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Template String Punctuation",
            "scope": ["punctuation.definition.template-expression", "string.template punctuation.definition.template-expression"],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Numbers and Constants",
            "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant"],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Booleans",
            "scope": ["constant.language.boolean"],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Types",
            "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class", "entity.name.namespace"],
            "settings": {
                "foreground": "#e5c07b"
            }
        },
        {
            "name": "Built-in Types",
            "scope": ["support.type.builtin", "support.type.primitive"],
            "settings": {
                "foreground": "#e5c07b",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Constructors",
            "scope": ["entity.name.function.constructor", "meta.class entity.name.function"],
            "settings": {
                "foreground": "#e5c07b"
            }
        },
        {
            "name": "Properties",
            "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.other.readwrite", "variable.other.local"],
            "settings": {
                "foreground": "#cccccc"
            }
        },
        {
            "name": "Variable Members",
            "scope": ["variable.other.member", "variable.other.enummember"],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "Variable Parameters",
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": {
                "foreground": "#cccccc",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Enum Values",
            "scope": ["variable.other.enum", "constant.other.enum"],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Tags (HTML/XML)",
            "scope": ["entity.name.tag", "meta.tag"],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "Tag Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "Punctuation",
            "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.terminator", "meta.brace"],
            "settings": {
                "foreground": "#848b98"
            }
        },
        {
            "name": "Brackets",
            "scope": ["punctuation.definition.block", "punctuation.definition.parameters", "punctuation.definition.arguments", "punctuation.brackets"],
            "settings": {
                "foreground": "#848b98"
            }
        },
        {
            "name": "Embedded",
            "scope": ["meta.embedded", "source.embedded"],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Preprocessor",
            "scope": ["meta.preprocessor", "keyword.control.directive"],
            "settings": {
                "foreground": "#c678dd"
            }
        },
        {
            "name": "Markdown Title",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": {
                "foreground": "#e5c07b",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Emphasis",
            "scope": ["markup.italic"],
            "settings": {
                "foreground": "#cccccc",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown Bold",
            "scope": ["markup.bold"],
            "settings": {
                "foreground": "#cccccc",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Link Text",
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": {
                "foreground": "#61afef",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown Link URL",
            "scope": ["markup.underline.link.href", "meta.link.inline.uri"],
            "settings": {
                "foreground": "#56b6c2"
            }
        },
        {
            "name": "Markdown List Marker",
            "scope": ["punctuation.definition.list", "markup.list"],
            "settings": {
                "foreground": "#61afef"
            }
        },
        {
            "name": "Markdown Code/Literal",
            "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
            "settings": {
                "foreground": "#98c379"
            }
        },
        {
            "name": "Label",
            "scope": ["entity.name.label", "support.other.label"],
            "settings": {
                "foreground": "#e5c07b"
            }
        },
        {
            "name": "JSON Property",
            "scope": ["support.type.property-name.json"],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "CSS Property",
            "scope": ["support.type.property-name.css", "support.type.property-name.scss", "support.type.property-name.less"],
            "settings": {
                "foreground": "#e06c75"
            }
        },
        {
            "name": "CSS Values",
            "scope": ["support.constant.property-value.css", "support.constant.font-name"],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "CSS Units",
            "scope": ["keyword.other.unit"],
            "settings": {
                "foreground": "#d19a66"
            }
        },
        {
            "name": "CSS Selectors",
            "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
            "settings": {
                "foreground": "#e5c07b"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "function": "#61afef",
        "function.declaration": "#61afef",
        "function.defaultLibrary": "#56b6c2",
        "method": "#61afef",
        "method.declaration": "#61afef",
        "variable": "#cccccc",
        "variable.readonly": "#d19a66",
        "variable.defaultLibrary": "#56b6c2",
        "parameter": {
            "foreground": "#cccccc",
            "fontStyle": "italic"
        },
        "property": "#e06c75",
        "property.declaration": "#e06c75",
        "type": "#e5c07b",
        "type.defaultLibrary": {
            "foreground": "#e5c07b",
            "fontStyle": "italic"
        },
        "class": "#e5c07b",
        "interface": "#e5c07b",
        "enum": "#d19a66",
        "enumMember": "#d19a66",
        "namespace": "#e5c07b",
        "keyword": "#c678dd",
        "string": "#98c379",
        "number": "#d19a66",
        "operator": "#56b6c2",
        "comment": {
            "foreground": "#5c6370",
            "fontStyle": "italic"
        },
        "regexp": "#56b6c2"
    }
}
